      "gate_effects": {
        "pass": "none",
        "warn": "marks_low_confidence",
        "fail": "blocks_transition",
        "blocked": "requires_reingest"
      },
      "lifecycle": "draft",
      "owner": "supervisory-state",
      "notes": "Anchors N4 policy-packs + N8 control. Evidence refs map to supervisory PolicyEvaluation entity."
    }
