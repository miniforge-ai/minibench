 :report/framework-id :acme-engineering
 :report/output-mode :clause-level
 :report/verdicts
 [{:verdict/dimension :technical-execution
   :verdict/level :l2
   :verdict/claims
   [{:claim/id "claim.acme.pipeline-rollout"
     :claim/text "Led the phased rollout of the evaluation pipeline"}]
   :verdict/envelope {:envelope/evidence-confidence 0.5}}
  {:verdict/dimension :technical-execution
   :verdict/level :l3
   :verdict/claims
   [{:claim/id "claim.acme.pipeline-rollout"
     :claim/text "Led the phased rollout of the evaluation pipeline"}]
   :verdict/envelope {:envelope/evidence-confidence 0.35}}]}
