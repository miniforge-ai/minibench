#!/usr/bin/env bash
# Pre-commit gate per miniforge-standards workflows/pre-commit-discipline
# (715). Never bypass — fix the root cause. Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

cargo fmt --all --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo test --workspace --all-targets --all-features
