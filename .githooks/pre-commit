#!/usr/bin/env bash
# Pre-commit gate per miniforge-standards workflows/pre-commit-discipline
# (715). Gate logic lives in the `bb pre-commit` task
# (workflows/bb-over-shell, 740). Never bypass — fix the root cause.
# Enable once per clone with:  git config core.hooksPath .githooks
set -euo pipefail

if ! command -v bb >/dev/null 2>&1; then
  echo "pre-commit: Babashka (bb) is required but not installed." >&2
  echo "  Install: brew install borkdude/brew/babashka  (or see https://github.com/babashka/babashka#installation)" >&2
  exit 1
fi

exec bb pre-commit
